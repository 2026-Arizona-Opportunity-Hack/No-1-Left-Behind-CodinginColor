# Copy to .env.local and fill in real values. .env* files are gitignored;
# this file documents what the app needs. Never put real keys in here.

# Supabase (Project Settings -> API Keys). The URL and publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: bypasses Row Level Security. Never expose to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Signs the student session cookie (any long random string: `openssl rand -hex 32`)
SESSION_SECRET=change-me

# AI drafting of lessons (OpenAI-compatible). Only curriculum text is ever sent, never student data.
# The OHack gateway key stops working Sun Nov 15, 6:00 PM AZ; after that, use your own provider's key.
# Leave AI_API_KEY empty to turn AI drafting off (manual authoring still works).
AI_BASE_URL=https://ai.ohack.dev/v1
AI_API_KEY=
AI_MODEL=gpt-oss-120b

# Optional: the public web address used in link previews. Vercel fills it in; set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://cic-launchpad.vercel.app
